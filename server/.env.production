# Backend Production Environment
# Copy to .env and update values before deploying

# Server Configuration
NODE_ENV=production
PORT=5000

# Frontend domain (used for CORS restrictions)
# Set this to your Vercel frontend URL during deployment
FRONTEND_URL=https://your-app.vercel.app

# ML Service URL (your hosted ML service)
# This should point to your deployed FastAPI service, e.g. https://api-yourapp.com or Render/Railway service
ML_SERVICE_URL=https://ml-service-yourapp.example.com

# File Upload Configuration
UPLOAD_DIR=./uploads
